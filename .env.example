# Contact form transport. Copy this file to .env and fill in the endpoint.
# .env is gitignored; this file is committed as documentation.
#
# The endpoint is the AWS Lambda Function URL set up in infra/contact/. Calling
# it from `npm run dev` also needs http://localhost:5173 in the Function URL's
# CORS allowed origins.
VITE_CONTACT_ENDPOINT=

# Only for a hosted form service such as Web3Forms. Leave empty for the Lambda.
VITE_CONTACT_ACCESS_KEY=
